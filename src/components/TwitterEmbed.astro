---
import { getSafeTweetUrl } from "@/utils/embedSecurity.mjs";

const { url } = Astro.props;
const safeUrl = getSafeTweetUrl(url);

if (!safeUrl) {
  throw new Error("TwitterEmbed requires a valid HTTPS X/Twitter status URL");
}
---

<div class="twitter-embed">
  <blockquote>
    <a href={safeUrl} target="_blank" rel="noopener noreferrer">View this post on X</a>
  </blockquote>
</div>

<style>
  .twitter-embed {
    margin: 2rem 0;
  }
</style>
